{
    "configurations": [
        {
            "name": "macOS",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/CDS",
                "/opt/homebrew/include",
                "/usr/local/include",
                "${workspaceFolder}/**"
            ],
            "defines": [
                "SDLGUI_USE_CORETEXT=1"
            ],
            "compilerPath": "/usr/bin/clang",
            "cStandard": "c99",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "macos-clang-arm64"
        },
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/CDS",
                "/usr/include",
                "/usr/include/freetype2",
                "/usr/include/fontconfig",
                "${workspaceFolder}/**"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c99",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}
